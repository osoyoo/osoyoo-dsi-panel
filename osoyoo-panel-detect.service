[Unit]
Description=OSOYOO DSI panel auto-detect (match config.txt overlay to the connected panel)
Documentation=https://github.com/osoyoo/osoyoo-dsi-panel
# The DSI touch controller is only powered once a panel overlay has loaded, so run
# late in boot. The script itself also retries while the controller comes up.
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/osoyoo-panel-detect

[Install]
WantedBy=multi-user.target
